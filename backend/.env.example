# Copy this file to .env and fill in real values. The app reads backend/.env
# when it starts; real environment variables (for example on Render) override it.
# Never commit the real .env: it is listed in .gitignore.

# Signs admin login tokens. Use a long random string, different for every site.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string

# Database.
# Local development with no setup (a file next to the code):
#   DATABASE_URL=sqlite:///./church.db
# Supabase (Postgres): Project Settings > Database > Connection string >
# "Transaction pooler". Paste it as-is. Special characters in the password
# must be URL-encoded (for example @ becomes %40).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Websites allowed to call this API, comma separated, no trailing slash.
# Add your Vercel address once the site is online.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# First admin account. Only used when the database has no admin yet.
# If ADMIN_PASSWORD is empty the account starts with a default password and
# must change it at first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Optional: where uploaded photos and audio are saved (default backend/uploads).
# UPLOADS_DIR=./uploads
