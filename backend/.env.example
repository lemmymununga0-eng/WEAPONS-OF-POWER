# Copy this file to .env and fill in real values before deploying anywhere public.
# The app falls back to insecure development defaults if these are unset.

SECRET_KEY=replace-with-a-long-random-string

# Local dev (default, zero setup):
DATABASE_URL=sqlite:///./church.db
# Supabase (Postgres) — from your Supabase project: Settings > Database >
# Connection string > "Transaction pooler" (recommended for serverless/free
# hosts like Render/Railway; use the "Session pooler" or direct connection
# if you need long-lived connections). Paste it in as-is, e.g.:
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
